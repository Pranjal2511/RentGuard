{
  "name": "rentguard",
  "version": "1.0.0",
  "private": true,
  "description": "RentGuard — Smart Rental Property Documentation and Dispute Management Platform",
  "workspaces": [
    "frontend",
    "backend",
    "ai-service"
  ],
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:ai": "npm run dev --workspace ai-service",
    "start:ai": "npm run start --workspace ai-service",
    "test": "npm run test --workspaces --if-present",
    "test:ai": "npm run test --workspace ai-service",
    "build": "npm run build:frontend",
    "lint": "npm run lint --workspace frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "seed": "npm run seed --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  }
}
