# RentGuard Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/rentguard

# Client URL (for CORS and Cookie security)
CLIENT_URL=http://localhost:5173

# Authentication Secrets
JWT_ACCESS_SECRET=rentguard_jwt_access_secret_super_secure_key_2026_change_in_prod
JWT_REFRESH_SECRET=rentguard_jwt_refresh_secret_super_secure_key_2026_change_in_prod
COOKIE_SECRET=rentguard_cookie_signing_secret_key_32bytes_change_in_prod

# Storage Provider (local | cloudinary | s3)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Cloudinary (Optional, if using cloud storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Microservice (Optional)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=rentguard_ai_shared_secret_token_change_in_prod

